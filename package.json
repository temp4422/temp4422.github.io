{
  "name": "dev-portfolio",
  "version": "3.0.1",
  "description": "My personal portfolio website https://temp4422.github.io",
  "homepage": "https://temp4422.github.io",
  "keywords": [
    "portfolio"
  ],
  "author": "temp4422",
  "license": "ISC",
  "type": "module",
  "main": "index.html",
  "engines": {
    "npm": "^11",
    "node": "^24"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "//1": "🔹 BASIC COMMANDS",
    "dev": "browser-sync start --server 'dist/' --files 'src/' --port 3000 --no-open --no-notify & node watch.js",
    "dev2": "serve dist/ & node watch.js",
    "prebuild": "npm run lint && npm run format",
    "build": "node index.js",
    "start": "serve dist/",
    "watch": "node watch.js",
    "webpack": "webpack --watch & webpack serve --open",
    "lint": "echo lint",
    "format": "echo npx prettier --write src/",
    "minify": "echo npx terser dist/server.js --module --ecma 2022 --compress drop_console=true --mangle --output dist/server.js",
    "lighthouse": "echo cd ./lighthouse/ && lighthouse http://localhost:3000 --quiet --chrome-flags='--headless'",
    "//2": "🔹 NEXT COMMANDS",
    "dev-next": "next dev",
    "build-next": "next build",
    "start-next": "next start",
    "lint-next": "next lint"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "html-minifier": "^4.0.0",
    "sharp": "^0.35.5",
    "uglify-js": "^3.19.3"
  }
}
